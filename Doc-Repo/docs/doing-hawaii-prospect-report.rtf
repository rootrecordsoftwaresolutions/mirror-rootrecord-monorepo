\page \pard\plain\f1\fs40\b\sa320 Safety, Trust, and Positioning Notes\b0\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\sa180 Because Doing Hawaii and Kilauea Alerts both touch volcano-related topics, trust and wording matter.\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\sa180 Recommended language:\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab "Creator perspective"\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab "Local media"\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab "Visual storytelling"\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab "Kilauea-related content"\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab "Follow official agencies for safety decisions"\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\sa180 Avoid language that implies:\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab Official authority\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab Emergency guidance\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab Guaranteed eruption predictions\par
\pard\plain\f0\fs28\sl360\slmult1\li540\fi-300\sa150 \bullet\tab Replacement for USGS/HVO/NWS/Hawai\u\ui County Civil Defense\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\sa180 For Kilauea Alerts integration, creator content should be clearly separated from official-source alerts and summaries.\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\sa180 Suggested disclaimer:\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
\pard\plain\f0\fs28\sl360\slmult1\sa180 "Doing Hawaii content is creator media and local perspective. For official volcano, weather, tsunami, and emergency guidance, follow USGS/HVO, National Weather Service, PTWC, Hawai\u\ui County Civil Defense, and other emergency authorities."\par
\pard\plain\f0\fs28\sl360\slmult1\sa220\par
