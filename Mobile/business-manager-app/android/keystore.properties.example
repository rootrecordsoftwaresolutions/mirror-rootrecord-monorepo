# Copy to keystore.properties and set paths relative to this android/ folder.
# Generate upload keystore: keytool -genkeypair -v -storetype PKCS12 -keystore upload-release.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=upload-release.jks
