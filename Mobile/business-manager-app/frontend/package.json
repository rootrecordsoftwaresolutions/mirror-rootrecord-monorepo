  "homepage": ".",
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^11.5.4",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "react-scripts": "5.0.1",
    "recharts": "^2.13.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:copy-artifacts": "node scripts/copy-android-artifacts.js",
    "android:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat clean assembleRelease && cd .. && node scripts/copy-android-artifacts.js apk",
    "android:bundle:release": "npm run build && npx cap sync android && cd android && .\\gradlew.bat bundleRelease && cd .. && node scripts/copy-android-artifacts.js aab",
    "android:apk-and-bundle": "npm run build && npx cap sync android && cd android && .\\gradlew.bat clean assembleRelease bundleRelease && cd .. && node scripts/copy-android-artifacts.js all",
    "pages:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../../Web/scripts/deploy-product-web-to-pages.ps1 -ProjectName rootrecord-business-web",
    "pages:deploy:only": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../../Web/scripts/deploy-product-web-to-pages.ps1 -ProjectName rootrecord-business-web -SkipBuild"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "fork-ts-checker-webpack-plugin": "6.5.3"
  },
  "devDependencies": {
    "ajv": "8.12.0",
    "typescript": "4.9.5",
    "@capacitor/cli": "^6.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "wrangler": "^3.114.0"
  }
}
