## Copy to `local.properties` (gitignored). Example:
# sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk
#
# BlockNotes Play upload key (create once — see README "Play signing"):
# RELEASE_STORE_FILE=keystore/blocknotes-upload.jks
# RELEASE_KEY_ALIAS=blocknotes-upload
# RELEASE_STORE_PASSWORD=your-keystore-password
# RELEASE_KEY_PASSWORD=your-keystore-password
#
# ADMOB_APPLICATION_ID=ca-app-pub-8245496571119619~4685237071
# ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-8245496571119619/2059073739
# ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-8245496571119619/8432910391
