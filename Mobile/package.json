{
  "name": "rootrecord-mobile-workspace",
  "private": true,
  "description": "Android (Capacitor) workspaces for Root Record apps. Web sources live under ../Web/apps/* and are not part of this workspace.",
  "scripts": {
    "install:all": "pnpm install",
    "weather:android:build": "pnpm --filter rootrecord-weather-android run android:build",
    "business:android:build": "pnpm --filter rootrecord-business-android run android:build",
    "account:android:build": "pnpm --filter rootrecord-account-android run android:build",
    "token:android:build": "pnpm --filter rootrecord-token-android run android:build"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["core-js", "core-js-pure"]
  }
}
