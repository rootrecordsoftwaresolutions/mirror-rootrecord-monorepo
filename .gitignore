**/node_modules/
**/.next/
**/.wrangler/
**/.gradle/
**/dist/
**/build/
**/__pycache__/
**/.venv/

# Editor tooling
.cursor/
*.env
credentials.json
*.pem
*.key
.credentials

# Android / Gradle local SDK paths (never commit)
**/local.properties

# Minecraft Paper runtime (downloaded jars, world, logs)
Minecraft/server/world/
Minecraft/server/logs/
Minecraft/server/cache/
Minecraft/server/libraries/
Minecraft/server/versions/
Minecraft/server/crash-reports/
