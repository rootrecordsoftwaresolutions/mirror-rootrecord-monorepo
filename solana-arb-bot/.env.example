# Copy to .env or set CREDENTIALS_ENV_PATH to an existing file (e.g. ../Web/credentials.env)

# --- Solana ---
# Helius / QuickNode / RPC Fast (required for production-quality latency)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# devnet: https://api.devnet.solana.com
COMMITMENT=confirmed

# Base mint for round-trip arb (mainnet USDC)
INPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
WALLET_ADDRESS=
# JSON array [..64 bytes..] OR base58 secret (32-byte seed or 64-byte expanded). NEVER COMMIT.
PRIVATE_KEY=
# Or use treasury-specific names (same values; loaded if PRIVATE_KEY unset):
# TREASURY_WALLET_ADDRESS=
# TREASURY_PRIVATE_KEY=
# TREASURY_SECRET_KEY_B58=

# --- Jupiter Swap API (Metis / swap v1 — lite tier; override for Pro api.jup.ag + key) ---
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_QUOTE_PATH=/quote
JUPITER_SWAP_PATH=/swap
# Legacy v6 (if you self-host): JUPITER_API_BASE=https://quote-api.jup.ag/v6 JUPITER_QUOTE_PATH=/quote ...
JUPITER_API_KEY=
# Lite API 429s easily — default 0.5 RPS (~2s between calls); raise only with Jupiter Pro
JUPITER_MAX_RPS=0.4
JUPITER_RATE_LIMIT_RETRIES=8

# --- Discovery ---
BIRDEYE_API_BASE=https://public-api.birdeye.so
BIRDEYE_API_KEY=
DEXSCREENER_API_BASE=https://api.dexscreener.com
DISCOVERY_INTERVAL_SEC=45
# Dexscreener pool liquidity (USD). Lower = more candidates, more illiquid / risky names.
MIN_LIQUIDITY_USD=10000
# 0 = no max age (required for major SOL/USDC pools; they are not “12h old”)
MAX_PAIR_AGE_MIN=0
MIN_PAIR_AGE_MIN=5
# Floor uses max(m5, h1/12, h24/24) so majors with m5=0 still qualify
MIN_VOLUME_5M_USD=2000
WATCHLIST_SIZE=15

# Seed mints (comma-separated) always considered if discovery fails
SEED_TOKEN_MINTS=So11111111111111111111111111111111111111112,DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263

# --- Risk / strategy ---
DRY_RUN=true
# 0 = any gross quote profit (out>in); 0.002 ≈ 0.2% conservative net floor (recommended before live)
MIN_PROFIT_NET_PCT=0.002
# Re-fetch Jupiter quotes immediately before swap (reduces stale leg2 vs scan-time quotes)
REFRESH_QUOTES_BEFORE_EXECUTE=true
MAX_SLIPPAGE_BPS=80
POSITION_SIZE_PCT=0.18
DAILY_MAX_LOSS_USD=15
MAX_CONCURRENT_TRADES=1
TOKEN_COOLDOWN_SEC=120
RPC_ERROR_BURST_LIMIT=8
DRAWDOWN_STOP_PCT=0.12
ESTIMATED_PRIORITY_FEE_USD=0.02
EXTRA_FEE_BUFFER_BPS=15

# --- Optional CEX SOL/USD hint (ccxt; off by default — avoids aiohttp/ccxt leaks + rate limits) ---
USE_CCXT_SOL_PRICE=false
SOL_PRICE_REFRESH_SEC=120

# --- Scanner ---
SCAN_INTERVAL_SEC=10
MAX_SCAN_CONCURRENCY=1

# --- Jito (optional) ---
USE_JITO_BUNDLE=false
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- HTTP dashboard (optional) ---
ENABLE_HTTP_DASHBOARD=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# --- Paths ---
TRADE_LOG_PATH=data/trades.jsonl
BLACKLIST_PATH=data/blacklist.json
STATE_PATH=data/bot_state.json

# --- Multi-env ---
CREDENTIALS_ENV_PATH=
