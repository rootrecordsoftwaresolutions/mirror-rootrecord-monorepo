# Vercel → Project → Settings → Environment Variables
#
# Nothing is required to deploy; the app has safe defaults.
# Add variables only when you need the feature.

# RootRecord portal (account / signup HTML on marketing site). Default: https://rootrecord.info
# NEXT_PUBLIC_ROOTRECORD_PORTAL_ORIGIN=https://rootrecord.info

# RootRecord API (custodial wallet + same Bearer as portal when using email sign-in from Solana Tools):
# NEXT_PUBLIC_ROOTRECORD_API_BASE=https://api.rootrecord.info
#
# Wallet admin (/admin/wallet-admin): server-only proxy — recommended dedicated secret (same on Worker):
#   wrangler secret put WALLET_ADMIN_PROXY_SECRET
# WALLET_ADMIN_PROXY_SECRET=
# Fallback: same value as Worker `RR_PUSH_ADMIN_SECRET` (header X-RR-Push-Admin-Key).
# RR_PUSH_ADMIN_SECRET=
# Optional override for the proxy upstream (defaults to NEXT_PUBLIC_ROOTRECORD_API_BASE or api.rootrecord.info):
# ROOTRECORD_API_BASE=https://api.rootrecord.info

# NEXT_PUBLIC_RPC_URL=https://…   (https:// added automatically if omitted)
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# (hostname only is OK, e.g. your-app.vercel.app — https:// is added automatically)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   (optional; overrides the default token in app/layout.tsx for Search Console)
# NEXT_PUBLIC_FEE_WALLET=   (pubkey that receives create/tools/Raydium/bulk **platform SOL fees** — use your **treasury**, not the ops/dev wallet from Tokenomics.)
# Example (default treasury / operator on mainnet docs): 3QG6gVk3fdimzQaKX9zf7J6kCs5DRLKg1RNea3VBosDJ
# If FEE_WALLET equals NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_DEVELOPER (or its default), the app sends fees to the treasury above instead.
# NEXT_PUBLIC_CREATE_FEE_SOL=0.025
# NEXT_PUBLIC_ACTION_FEE_SOL=0.01
# NEXT_PUBLIC_REFERRAL_SHARE_BPS=1000   (optional; basis points of each platform fee to eligible ?ref= wallet in same tx; default 1000 = 10%. Set 0 to disable.)
# NEXT_PUBLIC_LAUNCH_FEE_SOL=0.05   (Raydium pool launch tool; bundled in same tx as pool creation)
# NEXT_PUBLIC_ADD_LIQUIDITY_FEE_SOL=0.005   (add liquidity; bundled in same tx as Raydium deposit)
# NEXT_PUBLIC_REMOVE_LIQUIDITY_FEE_SOL=0.005   (remove liquidity; bundled in same tx as Raydium withdraw)
# NEXT_PUBLIC_LAUNCH_USDC_MINT=     (optional; defaults to mainnet/devnet USDC mint for “pair with USDC”)
# NEXT_PUBLIC_BULK_FEE_PER_ADDRESS_SOL=0.0005   (bulk SOL/SPL sends; per recipient line, bundled in each batch tx)
# NEXT_PUBLIC_BULK_FEE_PER_100_SOL=0.01   (legacy: if set without per-address, fee per line = this / 100)
# NEXT_PUBLIC_FREEZE_THAW_FEE_PER_ADDRESS_SOL=0.0005   (bulk freeze/thaw tool; per account in each batch tx)
# NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud
# (hostname only, e.g. mygateway.mypinata.cloud — no https://)

# Server-only (Vercel → same name, no NEXT_PUBLIC_ prefix):
# PINATA_JWT=
#
# Action log + “My Actions” read API → Cloudflare Worker (D1 `solana_site` + `solana_site_challenges`). Omit to skip (no-op).
# SOLANA_SITE_LOG_URL=https://<rootrecord-primary-host>/api/solana-site/log
# SOLANA_SITE_LOG_SECRET=<same value as Worker secret SOLANA_SITE_LOG_SECRET>
#
# New-mint Discord: when SOLANA_SITE_LOG_URL + SOLANA_SITE_LOG_SECRET are set, POST /api/solana-site/token-discord-notify
# is proxied to the same Worker host (same Bearer). Set the webhook on the Worker:
#   wrangler secret put DISCORD_TOKEN_CREATE_WEBHOOK_URL
# Optional fallback (local / preview without Worker): set DISCORD_TOKEN_CREATE_WEBHOOK_URL here on Vercel instead.
# DISCORD_TOKEN_CREATE_WEBHOOK_URL=https://discord.com/api/webhooks/…
#
# Server-only: treasury key for `/api/ecosystem/treasury-listing` (public pubkey + listing SPL balance; never exposes secret).
# Required for presale checkout (`/api/presale/transaction`): must be the listing mint authority (same pubkey as on-chain mint).
# ECOSYSTEM_OTC_TREASURY_PRIVATE_KEY=   (or ECOSYSTEM_OTC_TREASURY_SECRET_KEY) — same key encoding as Phantom export / JSON array.
#
# Presale checkout (tokenomics): min/max USD, optional kill-switch / force-open, USDC mint override.
# PRESALE_MIN_USD=1
# PRESALE_MAX_USD=250000
# NEXT_PUBLIC_PRESALE_CHECKOUT_DISABLED=true   (hide checkout UI + API)
# NEXT_PUBLIC_PRESALE_CHECKOUT_FORCE=true     (ignore countdown; for staging)
# NEXT_PUBLIC_MAINNET_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#
# Presale checkout — instant Raydium CPMM seed in the same transaction (server-only pool IDs):
# Matched tranche mints to treasury, then add-liquidity for the pool that matches payment:
#   SOL checkout → PRESALE_CP_MM_POOL_WSOL (listing + WSOL). USDC checkout → PRESALE_CP_MM_POOL_USDC.
# Omit both to keep checkout as pay + mint buyer only (no pool deposit). Fee-reserve slice stays on treasury.
# PRESALE_CP_MM_POOL_WSOL=
# PRESALE_CP_MM_POOL_USDC=
#
# Official listing mint (optional; default ROOTS mint is baked into `lib/ecosystemOtcConstants.ts`):
# NEXT_PUBLIC_ECOSYSTEM_TOKEN_MINT=
# Account / earn UI ticker (default RRTT; listing OTC copy still uses ROOTS):
# NEXT_PUBLIC_ECOSYSTEM_EARN_REWARD_SYMBOL=RRTT
#
# Comma-separated pool-related Solscan accounts (optional; defaults match custodial script exclusions):
# NEXT_PUBLIC_ECOSYSTEM_POOL_RELATED_ACCOUNTS=B5AZM1c9oPDUUY4bgyaEYNaGHbnPDXGp1qDqQeU1w9KW,GjFZgWjTBi8CW2KHPgMRXpLMkyUF3squZsnRZi4jLVNV,GjUnPAYqf3NQL5dDBDH2TdmgkSe53AdaXwDggxFKFryz
#
# Ecosystem /tokenomics Solscan labels (optional; defaults match production ROOTS deployment):
# NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_TREASURY=
# NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_DEVELOPER=
#
# If solana.rootrecord.info must route /api/* through Cloudflare rootrecord-primary Worker, set on that Worker:
#   wrangler secret put SOLANA_TOOLS_API_FORWARD_URL
# Value: https://<your-project>.vercel.app   (no trailing slash). Not needed when DNS sends the hostname straight to Vercel.
