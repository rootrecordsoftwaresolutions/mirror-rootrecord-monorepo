# Copy to .env — same RPC / keys pattern as solana-arb-bot (Web/credentials.env loaded first).
# By default sibling ../solana-arb-bot/.env is also loaded (override=False) so you can reuse PRIVATE_KEY there.
# SWING_LOAD_ARB_DOTENV=false to skip that.

SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
COMMITMENT=confirmed

WALLET_ADDRESS=
PRIVATE_KEY=

DRY_RUN=true

# Pair: USDC -> asset to hold on BUY (default SOL)
SWING_BASE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SWING_QUOTE_MINT=So11111111111111111111111111111111111111112
SWING_BASE_DECIMALS=6
SWING_QUOTE_DECIMALS=9

# Jupiter (lite tier — keep RPS low if arb bot also runs)
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_QUOTE_PATH=/quote
JUPITER_SWAP_PATH=/swap
JUPITER_API_KEY=
JUPITER_MAX_RPS=0.35
JUPITER_RATE_LIMIT_RETRIES=6
MAX_SLIPPAGE_BPS=80
# Swing-only fee cap (overrides JUPITER_* from shared credentials). ~100000 ≈ 0.0001 SOL tip ceiling + medium = cheap
SWING_JUPITER_PRIORITY_LEVEL=medium
SWING_PRIORITY_MAX_LAMPORTS=100000
# Optional: generic Jupiter keys if SWING_* unset
# JUPITER_PRIORITY_LEVEL=high
# JUPITER_PRIORITY_MAX_LAMPORTS=800000

# Strategy
SWING_LOOP_INTERVAL_SEC=60
SWING_FAST_SMA=12
SWING_SLOW_SMA=26
SWING_PRICE_PROBE_USDC=1.0
# BUY = pct of current USDC balance, then clamp (never more than wallet). Example: 0.02 = 2%
SWING_POSITION_PCT_OF_USDC=0.02
SWING_POSITION_MIN_USDC=5
SWING_POSITION_MAX_USDC=100
# SELL = this fraction of (native SOL − reserve). 1.0 = all spendable SOL
SWING_SELL_PCT_OF_SOL=1.0
SWING_SOL_RESERVE_LAMPORTS=25000000

SWING_STATE_PATH=data/swing_state.json
